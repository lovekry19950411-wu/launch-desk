{
  "name": "launch-desk",
  "version": "1.0.0",
  "description": "A polished launch-planning agent app built with the OpenAI Agents SDK.",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "build": "tsc && vite build",
    "test": "vitest run",
    "verify:e2e": "tsx scripts/verify-stream.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@openai/agents": "^0.11.4",
    "@openai/agents-core": "^0.11.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@worldcoin/idkit": "^4.1.5",
    "@worldcoin/idkit-core": "^4.1.5",
    "@worldcoin/minikit-js": "^2.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "^2.49.3",
    "vite": "^8.0.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
